# obd-logger — ESP-IDF v5.4 (P4+C6). Pierwszy build celowo bez WiFi/BT-over-hosted i bez LVGL.
# Uwaga: P4 nie ma wlasnego radia; BT/WiFi przez esp_hosted dodamy przy bring-upie (patrz README).

CONFIG_SPIRAM=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FATFS: dlugie nazwy (nazwy plikow logow)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# v0: BT wylaczone (hosted wlaczymy pozniej). UART/SD dzialaja od razu.
